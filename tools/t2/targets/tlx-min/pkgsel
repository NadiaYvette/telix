# Telix minimal userspace package selection.
#
# Real T2 pkgsel format (per t2sde/scripts/config-functions.lua
# `pkgsel_parse`): each line is `<action> <pattern>` where action is
# X (select), O (unselect), - (remove from list), = (baseline), or
# `include` (sub-file).  Pattern is glob — `*` is anything.
#
# Differs from T2's `embedded-minimal/pkgsel`:
#   - No `linux` / `linux-header` — Telix supplies its own kernel
#     via its Linux personality.
#   - No `dropbear` — no SSH until the personality has a usable
#     network story.

# Start by deselecting everything.
O *

# Toolchain (built in stages 0/1 — required to bootstrap any payload,
# not shipped to Telix).
X binutils
X gmp
X mpfr
X mpc
X gcc

# Libc (overridden via SDECFG_LIBC at config-write time; default glibc).
X glibc

# Payload — actually shipped to Telix via install-into-initramfs.sh.
X 00-dirtree
X busybox
X zlib
